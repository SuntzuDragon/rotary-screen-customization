{
  "name": "rotary-screen-customization",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter rotary-stats-web build",
    "dev": "pnpm --filter rotary-stats-web dev",
    "deploy": "pnpm --filter rotary-stats-worker deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:firmware": "git ls-files firmware/src firmware/include | grep -E '\\.(cpp|h)$' | xargs clang-format -i",
    "format:firmware:check": "git ls-files firmware/src firmware/include | grep -E '\\.(cpp|h)$' | xargs clang-format --dry-run --Werror",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.0"
  }
}
